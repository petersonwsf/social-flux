# Copie para `.env` (que NÃO é versionado) e ajuste. Veja docker-compose.yml.

# --- PostgreSQL (uma instância; um BANCO por serviço) ---
# authentication_service:
IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=troque-esta-senha
# profile_service: banco próprio na mesma instância (criado pelo serviço `profile_db_init`). Por padrão REUTILIZA o usuário e a
# senha acima; defina PROFILE_DB_USER/PROFILE_DB_PASSWORD só se quiser um role separado.
PROFILE_DB_NAME=profile
# PROFILE_DB_USER=
# PROFILE_DB_PASSWORD=
# social_graph_service: banco próprio (`social_graph`) na mesma instância; também reutiliza o usuário e a senha do auth.
# O banco precisa existir antes de o serviço subir (ver social_graph_service/README.md).
GRAPH_DB_NAME=social_graph
# GRAPH_DB_USER=
# GRAPH_DB_PASSWORD=
# Limites antiabuso do grafo (opcionais; valores padrão abaixo)
# GRAPH_FOLLOW_RATE_PER_HOUR=60
# GRAPH_MAX_FOLLOWING=7500
# GRAPH_MAX_PENDING_SENT=1000

# --- RabbitMQ (eventos entre serviços) ---
RABBITMQ_USER=socialflux
RABBITMQ_PASSWORD=troque-esta-senha-rabbit
# Painel: http://localhost:15672

# --- MySQL legado (backend Javalin; `usuario` é uma projeção do perfil) ---
LEGACY_DB_ROOT_PASSWORD=troque-esta-senha-root
LEGACY_DB_NAME=social_flux
LEGACY_DB_USER=social
LEGACY_DB_PASSWORD=troque-esta-senha

# --- JWT RS256 ---
# Gere com:  ./authentication_service/scripts/generate-jwt-key.sh   e cole as duas linhas abaixo.
JWT_PRIVATE_KEY_B64=
JWT_KEY_ID=
# Rotação: chaves públicas ANTERIORES (base64 de PEM), separadas por vírgula.
JWT_PUBLIC_KEYS_B64=
# Somente desenvolvimento: gera uma chave em memória se JWT_PRIVATE_KEY_B64 estiver vazio
# (as sessões caem a cada reinício do serviço). Em produção deixe `false`.
AUTH_ALLOW_EPHEMERAL_KEY=true

JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=socialflux-api
# Token de acesso de 2h; renova se o usuário agir de 10 min antes até 5 min depois do vencimento; sessão máx. 7 dias.
JWT_ACCESS_TTL=PT2H
JWT_RENEW_WINDOW=PT10M
JWT_REFRESH_GRACE=PT5M
SESSION_ABSOLUTE_MAX=P7D

# --- Cookies ---
# Desenvolvimento (http): sem Secure, sem prefixo.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_ACCESS_NAME=at
AUTH_COOKIE_REFRESH_NAME=rt
# Produção (https): AUTH_COOKIE_SECURE=true, AUTH_COOKIE_ACCESS_NAME=__Host-at, AUTH_COOKIE_REFRESH_NAME=__Secure-rt

# --- URLs ---
AUTH_PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_PORT=8080
# Para usar o frontend com `npm run dev` (HMR) atrás do gateway:  FRONTEND_UPSTREAM=host.docker.internal:5173
# FRONTEND_UPSTREAM=frontend:8080

# --- E-mail ---
MAIL_FROM=no-reply@socialflux.local
