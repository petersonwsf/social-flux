# Copie para `.env` NA VPS (ao lado do docker-compose.yml) e preencha. NUNCA versione o .env.
GHCR_OWNER=petersonwsf
# IMAGE_TAG=latest              # ou o SHA de um commit, para fixar/voltar uma versão

# --- URLs públicas (HTTPS, sem barra final) ---
JWT_ISSUER=https://social.seudominio.com
AUTH_PUBLIC_BASE_URL=https://social.seudominio.com
AUTH_ALLOWED_ORIGINS=https://social.seudominio.com
# AUTH_COOKIE_SECURE=true, AUTH_COOKIE_ACCESS_NAME=__Host-at e AUTH_COOKIE_REFRESH_NAME=__Secure-rt já são o padrão

# --- JWT RS256: gere com authentication_service/scripts/generate-jwt-key.sh e cole aqui ---
JWT_PRIVATE_KEY_B64=
JWT_KEY_ID=

# --- Banco (uma instância, um banco por serviço). Senha forte, ex.: openssl rand -base64 32 ---
IDENTITY_DB_PASSWORD=

# --- RabbitMQ (senha forte) ---
RABBITMQ_USER=socialflux
RABBITMQ_PASSWORD=

# --- RustFS (mídia). A chave de acesso só aceita letras MAIÚSCULAS e dígitos; a secreta: openssl rand -base64 33 ---
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# RUSTFS_TAG=                   # fixe a versão depois de testar

# --- E-mail (SMTP real) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@seudominio.com
